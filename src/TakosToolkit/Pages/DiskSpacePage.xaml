<Page x:Class="TakosToolkit.Pages.DiskSpacePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:TakosToolkit.Controls"
      Title="Disk Space"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="16,4,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <ComboBox x:Name="PathBox" Width="320" IsEditable="True" VerticalAlignment="Center"
                      ToolTip="Drive or folder to scan" KeyDown="PathBox_KeyDown" />
            <ui:Button Margin="6,0,0,0" Icon="{ui:SymbolIcon Folder24}" ToolTip="Choose a folder…"
                       Click="Browse_Click" VerticalAlignment="Stretch" />
            <ui:Button x:Name="ScanButton" Margin="6,0,0,0" Appearance="Primary" Content="Scan"
                       Icon="{ui:SymbolIcon Play24}" Click="Scan_Click" VerticalAlignment="Stretch" />
            <ui:Button x:Name="CancelButton" Margin="6,0,0,0" Content="Cancel" Visibility="Collapsed"
                       Icon="{ui:SymbolIcon Dismiss24}" Click="Cancel_Click" VerticalAlignment="Stretch" />
            <ui:Button x:Name="UpButton" Margin="18,0,0,0" Content="Up" IsEnabled="False"
                       Icon="{ui:SymbolIcon ArrowUp24}" Click="Up_Click" VerticalAlignment="Stretch"
                       ToolTip="Go to parent folder (mouse back button also works)" />
            <ui:Button x:Name="AdminButton" DockPanel.Dock="Right" Content="Restart as admin"
                       Icon="{ui:SymbolIcon Shield24}" Click="Admin_Click" VerticalAlignment="Stretch"
                       ToolTip="As admin, whole drives are read straight from the NTFS file table (much faster) and no folders are skipped." />
        </DockPanel>

        <!-- Location / progress -->
        <StackPanel Grid.Row="1" Margin="0,10,0,8">
            <TextBlock x:Name="LocationText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       Text="Choose a drive or folder and press Scan." />
            <TextBlock x:Name="ProgressText" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ProgressBar x:Name="ScanProgressBar" Margin="0,6,0,0" IsIndeterminate="True" Visibility="Collapsed" />
        </StackPanel>

        <!-- Treemap + side panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="380" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True"
                    BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <controls:TreemapControl x:Name="Treemap">
                    <controls:TreemapControl.ContextMenu>
                        <ContextMenu Opened="TreemapMenu_Opened">
                            <MenuItem x:Name="ZoomMenuItem" Header="Zoom into folder" Click="ZoomMenu_Click" />
                            <MenuItem Header="Show in Explorer" Click="ShowInExplorerMenu_Click" />
                            <MenuItem Header="Copy path" Click="CopyPathMenu_Click" />
                        </ContextMenu>
                    </controls:TreemapControl.ContextMenu>
                </controls:TreemapControl>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <TabControl Grid.Column="2">
                <TabItem Header="Largest files">
                    <DataGrid x:Name="LargestFilesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="None"
                              MouseDoubleClick="LargestFilesGrid_MouseDoubleClick"
                              ToolTip="Double-click to show in Explorer">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="80" />
                            <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="File types">
                    <DataGrid x:Name="ExtensionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Extension}" Width="*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="80" />
                            <DataGridTextColumn Header="%" Binding="{Binding PercentText}" SortMemberPath="Size" Width="55" />
                            <DataGridTextColumn Header="Files" Binding="{Binding Count, StringFormat=N0}" SortMemberPath="Count" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Legend">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LegendList" Margin="4,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Hover status -->
        <TextBlock x:Name="HoverText" Grid.Row="3" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Hover to see details · double-click a folder to zoom in · right-click for options" />
    </Grid>
</Page>
